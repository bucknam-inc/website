---
/**
 * Weighted PCI-over-time chart for one city.
 * Reads from src/data/pmp-history.json (generated by scripts/extract-pmp-data.py).
 * Renders pure SVG at build time — no client JavaScript shipped.
 */
import history from '../data/pmp-history.json';

type Survey = {
  year: number;
  pci: number;
  sections: number;
  coverage: number;
  start: string;
  end: string;
};

interface Props {
  city: string;
}

const { city } = Astro.props;
const data = (history as Record<string, Survey[]>)[city] ?? [];

// Chart geometry
const W = 840;
const H = 280;
const M = { top: 30, right: 24, bottom: 40, left: 48 };
const plotW = W - M.left - M.right;
const plotH = H - M.top - M.bottom;

// PCI bands (user-supplied boundaries: 0-40, 41-59, 60-74, 75-85, 86-100)
const bands = [
  { label: 'Very Poor', min: 0,  max: 40.5,  fill: '#ef4444' },
  { label: 'Poor',      min: 40.5, max: 59.5,  fill: '#f97316' },
  { label: 'Fair',      min: 59.5, max: 74.5,  fill: '#facc15' },
  { label: 'Good',      min: 74.5, max: 85.5,  fill: '#22c55e' },
  { label: 'Very Good', min: 85.5, max: 100,   fill: '#3b82f6' },
];

function bandColor(pci: number): string {
  for (const b of bands) if (pci <= b.max) return b.fill;
  return bands[bands.length - 1].fill;
}

// Year axis: actual inspection years only (user: NO projections)
const years = data.map((d) => d.year);
const minYear = years.length ? Math.min(...years) : 2000;
const maxYear = years.length ? Math.max(...years) : 2024;
// Pad a bit so end points aren't flush with the axes
const xDomainMin = minYear - 0.5;
const xDomainMax = maxYear + 0.5;

const xScale = (year: number) => M.left + ((year - xDomainMin) / (xDomainMax - xDomainMin)) * plotW;
const yScale = (pci: number) => M.top + (1 - pci / 100) * plotH;

// Build polyline path through all survey points
const linePath = data
  .map((d, i) => `${i === 0 ? 'M' : 'L'}${xScale(d.year).toFixed(1)},${yScale(d.pci).toFixed(1)}`)
  .join(' ');

// Year tick labels — every year, but thin out if too crowded
const yearTicks = (() => {
  const span = maxYear - minYear;
  const step = span > 20 ? 4 : span > 12 ? 2 : 1;
  const ticks: number[] = [];
  for (let y = Math.ceil(minYear / step) * step; y <= maxYear; y += step) ticks.push(y);
  if (!ticks.includes(minYear)) ticks.unshift(minYear);
  if (!ticks.includes(maxYear)) ticks.push(maxYear);
  return ticks;
})();
---
<figure class="pci-chart">
  <figcaption class="pci-chart__title">
    <span class="pci-chart__city">{city}</span>
    <span class="pci-chart__subtitle">Weighted average PCI by inspection survey</span>
  </figcaption>

  {data.length === 0 ? (
    <p class="pci-chart__empty">No historical PCI data available.</p>
  ) : (
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`PCI over time for ${city}`} class="pci-chart__svg">
      {/* Colored PCI bands */}
      {bands.map((b) => (
        <rect
          x={M.left}
          y={yScale(b.max)}
          width={plotW}
          height={Math.max(0, yScale(b.min) - yScale(b.max))}
          fill={b.fill}
          fill-opacity="0.16"
        />
      ))}

      {/* Y-axis gridlines + labels */}
      {[0, 25, 50, 75, 100].map((v) => (
        <>
          <line
            x1={M.left}
            y1={yScale(v)}
            x2={M.left + plotW}
            y2={yScale(v)}
            stroke="#1a1a1a"
            stroke-opacity="0.08"
            stroke-dasharray="2,3"
          />
          <text
            x={M.left - 8}
            y={yScale(v) + 4}
            text-anchor="end"
            font-size="11"
            fill="#6b7280"
            font-family="'Open Sans', sans-serif"
          >{v}</text>
        </>
      ))}

      {/* X-axis line + year ticks */}
      <line
        x1={M.left}
        y1={M.top + plotH}
        x2={M.left + plotW}
        y2={M.top + plotH}
        stroke="#1a1a1a"
        stroke-opacity="0.4"
      />
      {yearTicks.map((y) => (
        <>
          <line
            x1={xScale(y)}
            y1={M.top + plotH}
            x2={xScale(y)}
            y2={M.top + plotH + 4}
            stroke="#1a1a1a"
            stroke-opacity="0.4"
          />
          <text
            x={xScale(y)}
            y={M.top + plotH + 18}
            text-anchor="middle"
            font-size="11"
            fill="#4b5563"
            font-family="'Open Sans', sans-serif"
          >{y}</text>
        </>
      ))}

      {/* Data line */}
      <path d={linePath} fill="none" stroke="#1a1a1a" stroke-width="2" stroke-linejoin="round" />

      {/* Data points (colored by band) */}
      {data.map((d) => (
        <g>
          <circle cx={xScale(d.year)} cy={yScale(d.pci)} r="6" fill={bandColor(d.pci)} stroke="#1a1a1a" stroke-width="1.5">
            <title>{`${d.year}: PCI ${d.pci} (${d.sections} sections, ${Math.round(d.coverage * 100)}% of network)`}</title>
          </circle>
          <text
            x={xScale(d.year)}
            y={yScale(d.pci) - 12}
            text-anchor="middle"
            font-size="11"
            font-weight="600"
            fill="#1a1a1a"
            font-family="'Open Sans', sans-serif"
          >{d.pci.toFixed(0)}</text>
        </g>
      ))}
    </svg>
  )}
</figure>

<style>
  .pci-chart {
    margin: 0;
    padding: 1.25rem 1rem 0.75rem;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
  }
  .pci-chart__title {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin-bottom: 0.5rem;
    padding: 0 0.5rem;
  }
  .pci-chart__city {
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #1a1a1a;
    font-size: 1.05rem;
  }
  .pci-chart__subtitle {
    font-size: 0.78rem;
    color: #6b7280;
  }
  .pci-chart__svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .pci-chart__empty {
    color: #6b7280;
    font-size: 0.9rem;
    text-align: center;
    padding: 2rem;
  }
</style>
