---
const year = new Date().getFullYear();
---
<footer class="bg-brand-dark text-gray-300 mt-16">
  <div class="max-w-7xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-3 gap-8">
    <div>
      <div class="flex items-center gap-3 mb-4">
        <img src="/Logo_street_35px.png" alt="Bucknam" class="h-10" />
        <span class="font-heading text-xl text-white">BUCKNAM <span class="text-brand-yellow">INFRASTRUCTURE</span></span>
      </div>
      <p class="text-sm text-gray-400">
        Pavement management, GIS and infrastructure services for municipalities and private agencies across Southern California.
      </p>
    </div>
    <div>
      <h4 class="text-white font-heading uppercase tracking-wider mb-3 text-lg">Service Area</h4>
      <p class="text-sm text-gray-400">
        Los Angeles, Orange, San Bernardino, Riverside &amp; San Diego counties.
      </p>
      <a href="/contact/" class="inline-block mt-4 text-brand-yellow font-semibold text-sm no-underline hover:underline">
        Request a Proposal →
      </a>
    </div>
    <div>
      <h4 class="text-white font-heading uppercase tracking-wider mb-3 text-lg">Quick Links</h4>
      <ul class="text-sm space-y-1">
        <li><a href="/about-us/" class="text-gray-300 hover:text-brand-yellow no-underline">About</a></li>
        <li><a href="/service-map/" class="text-gray-300 hover:text-brand-yellow no-underline">Service Area</a></li>
        <li><a href="/myroads-application/" class="text-gray-300 hover:text-brand-yellow no-underline">MyRoads</a></li>
        <li><a href="/jobs/" class="text-gray-300 hover:text-brand-yellow no-underline">Careers</a></li>
        <li><a href="/contact/" class="text-gray-300 hover:text-brand-yellow no-underline">Contact</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-gray-800 py-4 text-center text-xs text-gray-500">
    &copy; {year} Bucknam Infrastructure Group, Inc. All rights reserved.
  </div>
</footer>
