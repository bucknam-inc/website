---
import Base from '../layouts/Base.astro';

const CONTACT_ENDPOINT = 'https://evlwmdaixjnxqktir6j42wvwgq0hskdq.lambda-url.us-east-1.on.aws/';
---
<Base title="Contact">
  <div class="bg-brand-dark text-white py-16">
    <div class="max-w-4xl mx-auto px-4">
      <h1 class="text-white">Contact</h1>
      <p class="text-gray-300 mt-2">Tell us about your project or your interest in joining the team.</p>
    </div>
  </div>
  <section class="max-w-3xl mx-auto px-4 py-12">
    <form id="contact-form" class="space-y-6">
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Name *</label>
        <input type="text" name="name" required class="w-full border border-gray-300 rounded px-4 py-2 focus:ring-2 focus:ring-brand-yellow" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Email *</label>
        <input type="email" name="email" required class="w-full border border-gray-300 rounded px-4 py-2 focus:ring-2 focus:ring-brand-yellow" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Phone</label>
        <input type="tel" name="phone" class="w-full border border-gray-300 rounded px-4 py-2 focus:ring-2 focus:ring-brand-yellow" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">I am contacting you regarding *</label>
        <select name="reason" required class="w-full border border-gray-300 rounded px-4 py-2 bg-white">
          <option value="">-- Select one --</option>
          <option>Pavement management proposal</option>
          <option>GIS services proposal</option>
          <option>ROW inventory</option>
          <option>MyRoads app / demo</option>
          <option>Address lookup tool</option>
          <option>Job application</option>
          <option>General inquiry</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Message *</label>
        <textarea name="message" rows="6" required class="w-full border border-gray-300 rounded px-4 py-2 focus:ring-2 focus:ring-brand-yellow"></textarea>
      </div>
      {/* honeypot — real users never fill "company"; bots generally do */}
      <input type="text" name="company" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button type="submit" class="btn-primary" data-send-label="Send Message" data-sending-label="Sending…">Send Message</button>
      <p id="contact-status" class="text-sm" role="status" aria-live="polite"></p>
    </form>
  </section>

  <script is:inline define:vars={{ endpoint: CONTACT_ENDPOINT }}>
    const form = document.getElementById('contact-form');
    const status = document.getElementById('contact-status');
    const button = form.querySelector('button[type="submit"]');
    const sendLabel = button.dataset.sendLabel;
    const sendingLabel = button.dataset.sendingLabel;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      status.className = 'text-sm';
      button.disabled = true;
      button.textContent = sendingLabel;
      const data = Object.fromEntries(new FormData(form).entries());
      const { reason, message, ...rest } = data;
      const composedMessage = reason ? `[${reason}]\n\n${message}` : message;
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...rest, message: composedMessage }),
        });
        if (res.ok) {
          status.textContent = "Thanks — we received your message and will reply soon.";
          status.className = 'text-sm text-green-700 font-semibold';
          form.reset();
        } else {
          const body = await res.json().catch(() => ({}));
          status.textContent = body.error || 'Something went wrong sending your message. Please try again.';
          status.className = 'text-sm text-red-700 font-semibold';
        }
      } catch (err) {
        status.textContent = 'Network error — please try again in a moment.';
        status.className = 'text-sm text-red-700 font-semibold';
      } finally {
        button.disabled = false;
        button.textContent = sendLabel;
      }
    });
  </script>
</Base>
