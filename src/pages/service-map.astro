---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const cityEntries = await getCollection('cities');
const cities = cityEntries.map((c) => c.data);

// Current fiscal year — FY26 = Jul 2025 – Jun 2026. Adjust if Bucknam uses a different FY boundary.
const now = new Date();
const currentFY = now.getMonth() >= 6 ? now.getFullYear() + 1 : now.getFullYear();

// Serialise the city list for the browser map bootstrap.
const cityJson = JSON.stringify(cities.map((c) => ({
  name: c.name,
  county: c.county,
  placeGeoId: c.placeGeoId ?? null,
  customGeoJson: c.customGeoJson ?? null,
  isCustomer: c.isCustomer,
  isCurrentSurvey: c.surveyYears.includes(currentFY),
})));
---
<Base title="Service Map">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <div class="bg-brand-dark text-white py-12">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-white">Service Area</h1>
      <p class="text-gray-300 mt-2">Our clients across Southern California — Los Angeles, Orange, San Bernardino, Riverside, and San Diego counties.</p>
    </div>
  </div>

  <section class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex items-center gap-6 mb-4 text-sm">
      <div class="flex items-center gap-2"><span class="inline-block w-4 h-4 bg-blue-500 opacity-70 border border-blue-700"></span> Current customer</div>
      <div class="flex items-center gap-2"><span class="inline-block w-4 h-4 bg-green-500 opacity-70 border border-green-700"></span> Surveying FY{currentFY}</div>
    </div>
    <div id="service-map" class="w-full h-[650px] rounded shadow-lg border border-gray-200"></div>
    <p class="text-xs text-gray-500 mt-2">
      City boundaries from US Census TIGER/Line "places" (2023). Data displayed: {cities.length} cities / {cities.filter((c) => c.isCustomer).length} customers.
    </p>
  </section>

  <script is:inline define:vars={{ cityJson, currentFY }}>
    window.__BUCKNAM_CITIES__ = JSON.parse(cityJson);
    window.__BUCKNAM_FY__ = currentFY;
  </script>
  <script type="module" src="/service-map.js"></script>
</Base>
